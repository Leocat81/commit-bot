{
  "name": "commit-bot",
  "displayName": "Commit Bot",
  "description": "AI-powered Git commit message generator using DeepSeek",
  "version": "0.0.1",
  "publisher": "commit-bot",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:commitBot.generate"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "commitBot.generate",
        "title": "Generate Commit Message",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "commitBot.generate",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "Commit Bot",
      "properties": {
        "commitBot.apiKey": {
          "type": "string",
          "default": "",
          "description": "DeepSeek API Key"
        },
        "commitBot.model": {
          "type": "string",
          "default": "deepseek-chat",
          "description": "Model name to use"
        },
        "commitBot.apiEndpoint": {
          "type": "string",
          "default": "https://api.deepseek.com/v1",
          "description": "API endpoint URL"
        },
        "commitBot.language": {
          "type": "string",
          "default": "zh-CN",
          "description": "Output language for commit messages"
        },
        "commitBot.maxDiffSize": {
          "type": "number",
          "default": 10000,
          "description": "Maximum diff size in characters"
        },
        "commitBot.customPrompt": {
          "type": "string",
          "default": "",
          "description": "Custom prompt template (leave empty for default)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2"
  }
}
